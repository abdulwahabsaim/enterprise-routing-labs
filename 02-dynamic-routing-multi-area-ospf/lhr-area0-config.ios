! ==============================================================================
! Device: Router LHR (Lahore Branch Gateway)
! Role: Internal Backbone Router (Area 0)
! Protocol: OSPFv2 (Process ID 7)
! Platform: Cisco 2811 (IOS 15.1)
! ==============================================================================
version 15.1
service timestamps log datetime msec
service timestamps debug datetime msec
no service password-encryption
!
hostname LHR
!
no ip domain-lookup
spanning-tree mode pvst
!
interface FastEthernet0/0
 no ip address
 shutdown
!
interface FastEthernet0/1
 description Backbone_Area0_LAN_Segment
 ip address 200.100.50.101 255.255.255.0
 duplex auto
 speed auto
 no shutdown
!
interface Serial0/0/0
 description WAN_Backbone_Transit_to_KHI
 ip address 1.1.1.1 255.0.0.0
 no shutdown
!
interface Serial0/0/1
 no ip address
 clock rate 2000000
 shutdown
!
interface Vlan1
 no ip address
 shutdown
!
router ospf 7
 log-adjacency-changes
 network 1.1.1.1 0.0.0.0 area 0
 network 200.100.50.0 0.0.0.255 area 0
!
ip classless
!
line con 0
 logging synchronous
line aux 0
line vty 0 4
 login
!
end
