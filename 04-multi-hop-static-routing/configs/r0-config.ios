! ==============================================================================
! Device: Router 0 (Branch 1 Gateway) | Platform: Cisco 1841 (IOS 12.4)
! ==============================================================================
version 12.4
hostname Router0
!
interface FastEthernet0/0
 description LAN_Branch_1
 ip address 192.168.1.1 255.255.255.0
 no shutdown
!
interface Serial0/1/0
 description WAN_to_Router1
 ip address 11.0.0.2 255.0.0.0
 no shutdown
!
ip classless
ip route 192.168.2.0 255.255.255.0 11.0.0.3
ip route 192.168.3.0 255.255.255.0 11.0.0.3
!
line con 0
line vty 0 4
 login
!
end
