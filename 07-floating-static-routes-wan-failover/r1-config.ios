hostname R1
!
interface GigabitEthernet0/1
 description ## LAN - Enterprise A (PC1) ##
 ip address 10.0.1.254 255.255.255.0
 no shutdown
!
interface GigabitEthernet0/0/0
 description ## Uplink to ISP A (Backup Path) ##
 ip address 203.0.113.2 255.255.255.252
 no shutdown
!
interface GigabitEthernet0/1/0
 description ## Uplink to ISP B (Primary Internet) ##
 ip address 203.0.113.10 255.255.255.252
 no shutdown
!
interface GigabitEthernet0/2/0
 description ## Internal P2P to R2 (Primary OSPF Path) ##
 ip address 10.0.0.1 255.255.255.252
 no shutdown
!
router ospf 1
 network 10.0.0.0 0.0.0.3 area 0
 network 10.0.1.0 0.0.0.255 area 0
 passive-interface GigabitEthernet0/1
!
! Primary Default Route to Internet
ip route 0.0.0.0 0.0.0.0 203.0.113.9
!
! Floating Static Route for WAN Failover 
! (AD 120 overrides OSPF AD 110 only if the internal R1-R2 link fails)
ip route 10.0.2.0 255.255.255.0 203.0.113.1 120
!
end
